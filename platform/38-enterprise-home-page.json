        "content": "<style>\n@keyframes cycle{0%,22%{opacity:1;transform:translateY(0)}25%,100%{opacity:0;transform:translateY(-8px)}}\n@keyframes pulse{0%,100%{opacity:0.8}50%{opacity:1}}\n@keyframes rotate{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}\n@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}\n.msg-wrap{position:relative;height:22px;width:100%;margin-top:14px}\n.msg{position:absolute;left:0;right:0;text-align:center;font-size:14px;opacity:0;animation:cycle 16s ease-in-out infinite}\n.m1{animation-delay:0s;color:#8E8EA0}\n.m2{animation-delay:4s;color:#73BF69}\n.m3{animation-delay:8s;color:#5794F2}\n.m4{animation-delay:12s;color:#FF9830}\n.logo-ring{animation:pulse 3s ease-in-out infinite;transform-origin:32px 32px}\n.logo-rot{animation:rotate 20s linear infinite;transform-origin:32px 32px}\n.grafana-text{background:linear-gradient(90deg,#F46800 0%,#FFB020 25%,#F46800 50%,#FFB020 75%,#F46800 100%);background-size:200% auto;background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:shimmer 4s linear infinite}\n.nav-link{transition:all 0.3s ease;padding:4px 0}\n.nav-link:hover{opacity:0.7;transform:translateY(-2px)}\n</style>\n<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif\">\n<svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\">\n<circle cx=\"32\" cy=\"32\" r=\"30\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"2\" class=\"logo-ring\"/>\n<circle cx=\"32\" cy=\"32\" r=\"22\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"1\" stroke-dasharray=\"4 4\" opacity=\"0.5\" class=\"logo-rot\"/>\n<circle cx=\"32\" cy=\"32\" r=\"14\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"1.5\" opacity=\"0.7\"/>\n<circle cx=\"32\" cy=\"32\" r=\"4\" fill=\"#F46800\"/>\n</svg>\n<div style=\"margin-top:20px;font-size:36px;font-weight:300;letter-spacing:3px\" class=\"grafana-text\">Grafana</div>\n<div class=\"msg-wrap\">\n<div class=\"msg m1\">👋 Welcome to Grafana — Your observability command center</div>\n<div class=\"msg m2\">📊 108 dashboards ready across LGTM, Azure, OCI, and more</div>\n<div class=\"msg m3\">🔍 Press Ctrl+K to search dashboards, alerts, and data sources</div>\n<div class=\"msg m4\">⚡ Observe. Analyze. Act. — All signals, one pane of glass</div>\n</div>\n<div style=\"margin-top:22px;padding:10px 32px;background:#111217;border:1px solid #2a2d35;border-radius:28px;color:#666;font-size:14px;min-width:440px;text-align:center\">🔍 &nbsp;Press <span style=\"background:#1a1d23;padding:2px 10px;border-radius:4px;color:#999;border:1px solid #333;font-size:11px;font-family:monospace\">⌘K</span> or <span style=\"background:#1a1d23;padding:2px 10px;border-radius:4px;color:#999;border:1px solid #333;font-size:11px;font-family:monospace\">Ctrl+K</span> to search</div>\n<div style=\"margin-top:22px;display:flex;gap:28px;align-items:center\">\n<a href=\"/dashboards\" class=\"nav-link\" style=\"color:#73BF69;text-decoration:none;font-size:13px\">📊 Dashboards</a>\n<a href=\"/explore\" class=\"nav-link\" style=\"color:#5794F2;text-decoration:none;font-size:13px\">🔭 Explore</a>\n<a href=\"/alerting/list\" class=\"nav-link\" style=\"color:#FF9830;text-decoration:none;font-size:13px\">🔔 Alerts</a>\n<a href=\"/connections/datasources\" class=\"nav-link\" style=\"color:#B877D9;text-decoration:none;font-size:13px\">🗄️ Data Sources</a>\n<a href=\"/plugins\" class=\"nav-link\" style=\"color:#33B5E5;text-decoration:none;font-size:13px\">🧩 Plugins</a>\n<a href=\"/admin\" class=\"nav-link\" style=\"color:#8E8EA0;text-decoration:none;font-size:13px\">⚙️ Admin</a>\n</div>\n</div>",
