        "content": "<style>\n/* \u2500\u2500\u2500 Theme variables \u2500\u2500\u2500 */\n#ghroot {\n  --gh-text:          #E5E9F0;\n  --gh-text-soft:     #8B93A6;\n  --gh-text-faint:    #4C566A;\n  --gh-divider:       #2E3440;\n  --gh-surface:       rgba(17,18,23,0.92);\n  --gh-surface-alt:   rgba(17,18,23,0.6);\n  --gh-surface-solid: #0b0c10;\n  --gh-border:        #2E3440;\n  --gh-border-soft:   rgba(255,255,255,0.04);\n  --gh-kbd-bg:        #0f1014;\n  --gh-kbd-fg:        #88C0D0;\n  --gh-accent-fg:     #88C0D0;\n  --gh-shadow:        0 10px 40px rgba(0,0,0,0.5);\n  --gh-shadow-focus:  0 12px 48px rgba(244,104,0,0.2);\n  --gh-shadow-drop:   0 24px 80px rgba(0,0,0,0.7);\n  --gh-hover-bg:      rgba(244,104,0,0.14);\n  --gh-glow-blue:     rgba(66,133,244,0.07);\n  --gh-glow-orange:   rgba(244,104,0,0.06);\n  --gh-glow-green:    rgba(163,190,140,0.03);\n  --gh-tile-alpha:    0.14;\n  --gh-res-bg:        rgba(17,18,23,0.5);\n}\n\nbody.theme-light #ghroot {\n  --gh-text:          #1F2937;\n  --gh-text-soft:     #6B7280;\n  --gh-text-faint:    #9CA3AF;\n  --gh-divider:       #E5E7EB;\n  --gh-surface:       rgba(255,255,255,0.95);\n  --gh-surface-alt:   rgba(255,255,255,0.8);\n  --gh-surface-solid: #FFFFFF;\n  --gh-border:        #E5E7EB;\n  --gh-border-soft:   rgba(0,0,0,0.05);\n  --gh-kbd-bg:        #F9FAFB;\n  --gh-kbd-fg:        #2563EB;\n  --gh-accent-fg:     #2563EB;\n  --gh-shadow:        0 8px 28px rgba(0,0,0,0.08);\n  --gh-shadow-focus:  0 12px 36px rgba(244,104,0,0.22);\n  --gh-shadow-drop:   0 16px 48px rgba(0,0,0,0.15);\n  --gh-hover-bg:      rgba(244,104,0,0.1);\n  --gh-glow-blue:     rgba(66,133,244,0.05);\n  --gh-glow-orange:   rgba(244,104,0,0.05);\n  --gh-glow-green:    rgba(163,190,140,0.04);\n  --gh-tile-alpha:    0.10;\n  --gh-res-bg:        rgba(255,255,255,0.7);\n}\n\n/* \u2500\u2500\u2500 Animations \u2500\u2500\u2500 */\n@keyframes gh_pulse { 0%,100% { transform:scale(1); opacity:0.9; } 50% { transform:scale(1.15); opacity:1; } }\n@keyframes gh_spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }\n@keyframes gh_fade_up { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }\n\n#ghroot { animation: gh_fade_up 0.6s ease-out; color: var(--gh-text); }\n#gh_dot { animation: gh_pulse 2.4s ease-in-out infinite; transform-origin: center; }\n#gh_orbit_outer { animation: gh_spin 40s linear infinite; transform-origin: 50px 50px; }\n#gh_orbit_mid { animation: gh_spin 25s linear infinite reverse; transform-origin: 50px 50px; }\n\n/* \u2500\u2500\u2500 Input & results \u2500\u2500\u2500 */\n#ghsearch { color: var(--gh-text); }\n#ghsearch::placeholder { color: var(--gh-text-soft); opacity: 1; }\n#ghsearch:focus { outline: none; }\n#ghresults::-webkit-scrollbar { width: 8px; }\n#ghresults::-webkit-scrollbar-track { background: transparent; }\n#ghresults::-webkit-scrollbar-thumb { background: var(--gh-border); border-radius: 4px; }\n#ghresults::-webkit-scrollbar-thumb:hover { background: var(--gh-text-faint); }\n#ghresults a:hover { background: var(--gh-hover-bg) !important; }\n#ghresults a { color: var(--gh-text) !important; }\n\n/* \u2500\u2500\u2500 Tile & resource hover \u2500\u2500\u2500 */\n.gh_tile, .gh_res { transition: all 0.25s ease; }\n.gh_tile:hover { transform: translateY(-3px); }\n.gh_res:hover { transform: translateY(-2px); border-color: var(--gh-accent-fg) !important; }\n</style>\n\n<div id=\"ghroot\" style=\"position:relative;width:100%;height:100%;display:flex;flex-direction:column;align-items:stretch;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;\">\n\n<div style=\"position:absolute;top:8%;left:10%;width:300px;height:300px;background:radial-gradient(circle,var(--gh-glow-blue) 0%,transparent 70%);filter:blur(60px);pointer-events:none;\"></div>\n<div style=\"position:absolute;bottom:8%;right:10%;width:360px;height:360px;background:radial-gradient(circle,var(--gh-glow-orange) 0%,transparent 70%);filter:blur(70px);pointer-events:none;\"></div>\n<div style=\"position:absolute;top:40%;left:50%;transform:translate(-50%,-50%);width:500px;height:500px;background:radial-gradient(circle,var(--gh-glow-green) 0%,transparent 60%);filter:blur(80px);pointer-events:none;\"></div>\n\n<!-- \u2550\u2550\u2550 TOP: Welcome bar with avatar + username \u2550\u2550\u2550 -->\n<div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;padding:22px 40px 0 40px;\">\n<div style=\"display:flex;align-items:center;gap:12px;\">\n<img id=\"gh_avatar\" src=\"/avatar/46d229b9c970e63895790d1d53fe1f44\" alt=\"\" style=\"width:36px;height:36px;border-radius:50%;border:2px solid var(--gh-border);box-shadow:0 2px 8px rgba(0,0,0,0.2);\">\n<span style=\"font-size:13px;color:var(--gh-text-soft);letter-spacing:0.2px;\">Welcome to <strong style=\"color:var(--gh-text);font-weight:700;\">o11Y Place</strong>, <span id=\"gh_username\" style=\"color:#F46800;font-weight:700;\">&hellip;</span></span>\n</div>\n<div style=\"font-size:11px;color:var(--gh-text-soft);letter-spacing:0.3px;text-align:right;\">\n<span id=\"gh_now\" style=\"font-variant-numeric:tabular-nums;\">&hellip;</span>\n<div style=\"font-size:9px;color:var(--gh-text-faint);letter-spacing:0.5px;margin-top:2px;text-transform:uppercase;\" id=\"gh_today\">&hellip;</div>\n</div>\n</div>\n\n<!-- \u2550\u2550\u2550 MIDDLE: centered main content \u2550\u2550\u2550 -->\n<div style=\"flex:1;position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px 40px 16px 40px;\">\n\n<svg width=\"78\" height=\"78\" viewBox=\"0 0 100 100\" style=\"margin-bottom:2px;\">\n<defs>\n<radialGradient id=\"gh_glow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n<stop offset=\"0%\" stop-color=\"#F46800\" stop-opacity=\"0.9\"/>\n<stop offset=\"100%\" stop-color=\"#F46800\" stop-opacity=\"0\"/>\n</radialGradient>\n</defs>\n<circle cx=\"50\" cy=\"50\" r=\"44\" fill=\"url(#gh_glow)\" opacity=\"0.3\"/>\n<g id=\"gh_orbit_outer\">\n<circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"1\" opacity=\"0.4\" stroke-dasharray=\"2 4\"/>\n<circle cx=\"96\" cy=\"50\" r=\"2.8\" fill=\"#4285F4\"/>\n<circle cx=\"82\" cy=\"20\" r=\"1.8\" fill=\"#B48EAD\"/>\n</g>\n<g id=\"gh_orbit_mid\">\n<circle cx=\"50\" cy=\"50\" r=\"32\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"0.9\" opacity=\"0.6\"/>\n<circle cx=\"82\" cy=\"50\" r=\"2.2\" fill=\"#34A853\"/>\n<circle cx=\"18\" cy=\"50\" r=\"1.8\" fill=\"#FBBC05\"/>\n</g>\n<circle cx=\"50\" cy=\"50\" r=\"18\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"0.8\" opacity=\"0.8\"/>\n<circle id=\"gh_dot\" cx=\"50\" cy=\"50\" r=\"6\" fill=\"#F46800\"/>\n</svg>\n\n<h1 style=\"margin:14px 0 4px;font-size:42px;font-weight:200;letter-spacing:7px;color:var(--gh-text);line-height:1;\">Grafana</h1>\n<p style=\"margin:0 0 26px;font-size:10px;font-weight:600;letter-spacing:3px;color:var(--gh-text-soft);text-transform:uppercase;\">Enterprise Observability Platform</p>\n\n<div style=\"position:relative;width:100%;max-width:640px;\">\n\n<div onclick='document.getElementById(\"ghsearch\").focus();' style=\"display:flex;align-items:center;background:var(--gh-surface);border:1px solid var(--gh-border);border-radius:32px;padding:16px 26px;box-shadow:var(--gh-shadow);transition:all 0.3s ease;cursor:text;\">\n\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex-shrink:0;color:var(--gh-text-soft);stroke:currentColor;\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>\n\n<input id=\"ghsearch\" autocomplete=\"off\" autofocus placeholder=\"Search dashboards, alerts, data sources...\" style=\"flex:1;margin-left:14px;background:transparent;border:none;outline:none;font-size:14px;font-family:inherit;\" oninput='var el=this;clearTimeout(window.__gstim);window.__gstim=setTimeout(function(){var q=el.value.trim();var d=document.getElementById(\"ghresults\");if(!q){d.style.display=\"none\";return;}fetch(\"/api/search?query=\"+encodeURIComponent(q)+\"&limit=15\",{credentials:\"include\"}).then(function(r){return r.json();}).then(function(j){if(!j||!j.length){d.innerHTML=`<div style=\"padding:28px;color:var(--gh-text-soft);text-align:center;font-size:13px;\">No results for <strong style=\"color:var(--gh-text);\">${q}</strong></div>`;d.style.display=\"block\";return;}d.innerHTML=`<div style=\"padding:10px 20px 6px;font-size:10px;color:var(--gh-text-soft);text-transform:uppercase;letter-spacing:1px;font-weight:600;border-bottom:1px solid var(--gh-border-soft);\">${j.length} result${j.length>1?\"s\":\"\"}</div>`+j.map(function(x){var f=x.folderTitle||\"General\";return `<a href=\"${x.url}\" style=\"display:flex;align-items:center;gap:14px;padding:13px 20px;text-decoration:none;border-bottom:1px solid var(--gh-border-soft);transition:background 0.12s;\"><div style=\"width:32px;height:32px;border-radius:8px;background:rgba(244,104,0,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/></svg></div><div style=\"flex:1;min-width:0;\"><div style=\"font-size:10px;color:var(--gh-text-soft);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:2px;font-weight:600;\">${f}</div><div style=\"font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">${x.title}</div></div><span style=\"color:var(--gh-text-soft);font-size:18px;flex-shrink:0;\">&rarr;</span></a>`;}).join(\"\");d.style.display=\"block\";}).catch(function(e){d.innerHTML=`<div style=\"padding:22px;color:#BF616A;text-align:center;font-size:13px;\">Error: ${e.message}</div>`;d.style.display=\"block\";});},180);' onkeydown='if(event.key===\"Escape\"){this.value=\"\";document.getElementById(\"ghresults\").style.display=\"none\";this.blur();}else if(event.key===\"Enter\"){var f=document.querySelector(\"#ghresults a\");if(f){event.preventDefault();window.location.href=f.getAttribute(\"href\");}}' onfocus='this.parentElement.style.borderColor=\"#F46800\";this.parentElement.style.boxShadow=\"var(--gh-shadow-focus)\";' onblur='var p=this.parentElement;setTimeout(function(){var d=document.getElementById(\"ghresults\");if(d)d.style.display=\"none\";},220);p.style.borderColor=\"var(--gh-border)\";p.style.boxShadow=\"var(--gh-shadow)\";'>\n\n<span style=\"margin-left:10px;padding:4px 10px;background:var(--gh-kbd-bg);border:1px solid var(--gh-border);border-radius:6px;font-size:10px;color:var(--gh-kbd-fg);font-family:monospace;font-weight:700;flex-shrink:0;\">Esc</span>\n\n</div>\n\n<div id=\"ghresults\" style=\"display:none;position:absolute;top:calc(100% + 10px);left:0;right:0;background:var(--gh-surface-solid);border:1px solid var(--gh-border);border-radius:16px;max-height:340px;overflow-y:auto;box-shadow:var(--gh-shadow-drop);z-index:1000;\"></div>\n\n</div>\n\n<div style=\"margin-top:16px;font-size:11px;color:var(--gh-text-soft);letter-spacing:0.5px;\">Type to search &middot; <span style=\"color:var(--gh-accent-fg);font-weight:600;\">Enter</span> opens first result &middot; <span style=\"color:var(--gh-accent-fg);font-weight:600;\">Esc</span> clears</div>\n\n<!-- Action tiles -->\n<div style=\"margin-top:32px;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;width:100%;max-width:900px;\">\n\n<a href=\"/dashboards?starred=true\" class=\"gh_tile\" data-accent=\"244,104,0\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(244,104,0,var(--gh-tile-alpha)),rgba(244,104,0,0.02));border:1px solid rgba(244,104,0,0.3);border-radius:14px;padding:16px 10px;text-align:center;\" onmouseover='this.style.borderColor=\"#F46800\";this.style.boxShadow=\"0 8px 24px rgba(244,104,0,0.28)\";' onmouseout='this.style.borderColor=\"rgba(244,104,0,0.3)\";this.style.boxShadow=\"none\";'><div style=\"width:38px;height:38px;margin:0 auto 6px;border-radius:10px;background:rgba(244,104,0,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#F46800\" stroke=\"#F46800\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg></div><div id=\"gh_starred_label\" style=\"font-size:11px;font-weight:600;color:var(--gh-text);letter-spacing:0.3px;\">Starred</div></a>\n\n<a href=\"/explore\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(66,133,244,var(--gh-tile-alpha)),rgba(66,133,244,0.02));border:1px solid rgba(66,133,244,0.3);border-radius:14px;padding:16px 10px;text-align:center;\" onmouseover='this.style.borderColor=\"#4285F4\";this.style.boxShadow=\"0 8px 24px rgba(66,133,244,0.28)\";' onmouseout='this.style.borderColor=\"rgba(66,133,244,0.3)\";this.style.boxShadow=\"none\";'>\n<div style=\"width:38px;height:38px;margin:0 auto 6px;border-radius:10px;background:rgba(66,133,244,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4285F4\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/><line x1=\"11\" y1=\"8\" x2=\"11\" y2=\"14\"/><line x1=\"8\" y1=\"11\" x2=\"14\" y2=\"11\"/></svg></div>\n<div style=\"font-size:11px;font-weight:600;color:var(--gh-text);letter-spacing:0.3px;\">Explore</div>\n</a>\n\n<a href=\"/d/l1-application-performance\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(52,168,83,var(--gh-tile-alpha