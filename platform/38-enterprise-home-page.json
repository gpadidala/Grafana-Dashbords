        "content": "<style>\n@keyframes gh_pulse { 0%,100% { transform:scale(1); opacity:0.9; } 50% { transform:scale(1.15); opacity:1; } }\n@keyframes gh_spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }\n@keyframes gh_fade_up { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }\n#ghroot { animation: gh_fade_up 0.6s ease-out; }\n#gh_dot { animation: gh_pulse 2.4s ease-in-out infinite; transform-origin: center; }\n#gh_orbit_outer { animation: gh_spin 40s linear infinite; transform-origin: 50px 50px; }\n#gh_orbit_mid { animation: gh_spin 25s linear infinite reverse; transform-origin: 50px 50px; }\n#ghsearch::placeholder { color:#4C566A; }\n#ghsearch:focus { outline:none; }\n#ghresults::-webkit-scrollbar { width:8px; }\n#ghresults::-webkit-scrollbar-track { background:transparent; }\n#ghresults::-webkit-scrollbar-thumb { background:#2E3440; border-radius:4px; }\n#ghresults::-webkit-scrollbar-thumb:hover { background:#434C5E; }\n.gh_tile:hover { transform:translateY(-3px); }\n</style>\n\n<div id=\"ghroot\" style=\"position:relative;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding-top:54px;padding-bottom:30px;background:radial-gradient(ellipse 70% 50% at 50% 30%, rgba(244,104,0,0.05) 0%, transparent 70%);font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;\">\n\n<div style=\"position:absolute;top:8%;left:10%;width:300px;height:300px;background:radial-gradient(circle,rgba(66,133,244,0.07) 0%,transparent 70%);filter:blur(60px);pointer-events:none;\"></div>\n<div style=\"position:absolute;bottom:8%;right:10%;width:360px;height:360px;background:radial-gradient(circle,rgba(244,104,0,0.06) 0%,transparent 70%);filter:blur(70px);pointer-events:none;\"></div>\n<div style=\"position:absolute;top:40%;left:50%;transform:translate(-50%,-50%);width:500px;height:500px;background:radial-gradient(circle,rgba(163,190,140,0.03) 0%,transparent 60%);filter:blur(80px);pointer-events:none;\"></div>\n\n<div style=\"position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;width:100%;max-width:960px;padding:0 40px;\">\n\n<svg width=\"86\" height=\"86\" viewBox=\"0 0 100 100\" style=\"margin-bottom:2px;\">\n<defs>\n<radialGradient id=\"gh_glow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n<stop offset=\"0%\" stop-color=\"#F46800\" stop-opacity=\"0.9\"/>\n<stop offset=\"100%\" stop-color=\"#F46800\" stop-opacity=\"0\"/>\n</radialGradient>\n</defs>\n<circle cx=\"50\" cy=\"50\" r=\"44\" fill=\"url(#gh_glow)\" opacity=\"0.3\"/>\n<g id=\"gh_orbit_outer\">\n<circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"1\" opacity=\"0.35\" stroke-dasharray=\"2 4\"/>\n<circle cx=\"96\" cy=\"50\" r=\"2.8\" fill=\"#4285F4\"/>\n<circle cx=\"82\" cy=\"20\" r=\"1.8\" fill=\"#B48EAD\"/>\n</g>\n<g id=\"gh_orbit_mid\">\n<circle cx=\"50\" cy=\"50\" r=\"32\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"0.9\" opacity=\"0.55\"/>\n<circle cx=\"82\" cy=\"50\" r=\"2.2\" fill=\"#34A853\"/>\n<circle cx=\"18\" cy=\"50\" r=\"1.8\" fill=\"#FBBC05\"/>\n</g>\n<circle cx=\"50\" cy=\"50\" r=\"18\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"0.8\" opacity=\"0.75\"/>\n<circle id=\"gh_dot\" cx=\"50\" cy=\"50\" r=\"6\" fill=\"#F46800\"/>\n</svg>\n\n<h1 style=\"margin:18px 0 4px;font-size:46px;font-weight:200;letter-spacing:7px;color:#E5E9F0;line-height:1;\">Grafana</h1>\n<p style=\"margin:0 0 30px;font-size:10px;font-weight:600;letter-spacing:3px;color:#4C566A;text-transform:uppercase;\">Enterprise Observability Platform</p>\n\n<div style=\"position:relative;width:100%;max-width:640px;\">\n\n<div onclick='document.getElementById(\"ghsearch\").focus();' style=\"display:flex;align-items:center;background:rgba(17,18,23,0.92);border:1px solid #2E3440;border-radius:32px;padding:16px 26px;box-shadow:0 10px 40px rgba(0,0,0,0.5);transition:all 0.3s ease;cursor:text;\">\n\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4C566A\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex-shrink:0;\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>\n\n<input id=\"ghsearch\" autocomplete=\"off\" autofocus placeholder=\"Search 111 dashboards, alerts, data sources...\" style=\"flex:1;margin-left:14px;background:transparent;border:none;outline:none;color:#E5E9F0;font-size:14px;font-family:inherit;\" oninput='var el=this;clearTimeout(window.__gstim);window.__gstim=setTimeout(function(){var q=el.value.trim();var d=document.getElementById(\"ghresults\");if(!q){d.style.display=\"none\";return;}fetch(\"/api/search?query=\"+encodeURIComponent(q)+\"&limit=15\",{credentials:\"include\"}).then(function(r){return r.json();}).then(function(j){if(!j||!j.length){d.innerHTML=`<div style=\"padding:28px;color:#4C566A;text-align:center;font-size:13px;\">No results for <strong style=\"color:#D8DEE9;\">${q}</strong></div>`;d.style.display=\"block\";return;}d.innerHTML=`<div style=\"padding:10px 20px 6px;font-size:10px;color:#4C566A;text-transform:uppercase;letter-spacing:1px;font-weight:600;border-bottom:1px solid rgba(255,255,255,0.04);\">${j.length} result${j.length>1?\"s\":\"\"}</div>`+j.map(function(x){var f=x.folderTitle||\"General\";return `<a href=\"${x.url}\" style=\"display:flex;align-items:center;gap:14px;padding:13px 20px;text-decoration:none;border-bottom:1px solid rgba(255,255,255,0.04);transition:background 0.12s;\"><div style=\"width:32px;height:32px;border-radius:8px;background:rgba(244,104,0,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/></svg></div><div style=\"flex:1;min-width:0;\"><div style=\"font-size:10px;color:#4C566A;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:2px;font-weight:600;\">${f}</div><div style=\"font-size:14px;color:#E5E9F0;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">${x.title}</div></div><span style=\"color:#4C566A;font-size:18px;flex-shrink:0;\">&rarr;</span></a>`;}).join(\"\");d.style.display=\"block\";}).catch(function(e){d.innerHTML=`<div style=\"padding:22px;color:#BF616A;text-align:center;font-size:13px;\">Error: ${e.message}</div>`;d.style.display=\"block\";});},180);' onkeydown='if(event.key===\"Escape\"){this.value=\"\";document.getElementById(\"ghresults\").style.display=\"none\";this.blur();}else if(event.key===\"Enter\"){var f=document.querySelector(\"#ghresults a\");if(f){event.preventDefault();window.location.href=f.getAttribute(\"href\");}}' onfocus='this.parentElement.style.borderColor=\"#F46800\";this.parentElement.style.boxShadow=\"0 12px 48px rgba(244,104,0,0.2)\";' onblur='var p=this.parentElement;setTimeout(function(){var d=document.getElementById(\"ghresults\");if(d)d.style.display=\"none\";},220);p.style.borderColor=\"#2E3440\";p.style.boxShadow=\"0 10px 40px rgba(0,0,0,0.5)\";'>\n\n<span style=\"margin-left:10px;padding:4px 10px;background:#0f1014;border:1px solid #2E3440;border-radius:6px;font-size:10px;color:#88C0D0;font-family:monospace;font-weight:700;flex-shrink:0;\">Esc</span>\n\n</div>\n\n<div id=\"ghresults\" style=\"display:none;position:absolute;top:calc(100% + 10px);left:0;right:0;background:#0b0c10;border:1px solid #2E3440;border-radius:16px;max-height:340px;overflow-y:auto;box-shadow:0 24px 80px rgba(0,0,0,0.7);z-index:1000;\" onmouseover='var a=event.target.closest(\"a\");if(a)a.style.background=\"rgba(244,104,0,0.1)\";' onmouseout='var a=event.target.closest(\"a\");if(a)a.style.background=\"transparent\";'></div>\n\n</div>\n\n<div style=\"margin-top:18px;font-size:11px;color:#4C566A;letter-spacing:0.5px;\">Type to search &middot; <span style=\"color:#88C0D0;font-weight:600;\">Enter</span> opens first result &middot; <span style=\"color:#88C0D0;font-weight:600;\">Esc</span> clears</div>\n\n<div style=\"margin-top:38px;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;width:100%;max-width:900px;\">\n\n<a href=\"/d/l0-executive-command-center\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(244,104,0,0.14),rgba(244,104,0,0.02));border:1px solid rgba(244,104,0,0.25);border-radius:14px;padding:18px 10px;text-align:center;transition:all 0.25s ease;\" onmouseover='this.style.transform=\"translateY(-3px)\";this.style.borderColor=\"#F46800\";this.style.boxShadow=\"0 8px 24px rgba(244,104,0,0.28)\";' onmouseout='this.style.transform=\"none\";this.style.borderColor=\"rgba(244,104,0,0.25)\";this.style.boxShadow=\"none\";'>\n<div style=\"width:40px;height:40px;margin:0 auto 8px;border-radius:10px;background:rgba(244,104,0,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#F46800\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><line x1=\"21.17\" y1=\"8\" x2=\"12\" y2=\"8\"/><line x1=\"3.95\" y1=\"6.06\" x2=\"8.54\" y2=\"14\"/><line x1=\"10.88\" y1=\"21.94\" x2=\"15.46\" y2=\"14\"/></svg></div>\n<div style=\"font-size:11px;font-weight:600;color:#E5E9F0;letter-spacing:0.3px;\">Command</div>\n</a>\n\n<a href=\"/explore\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(136,192,208,0.14),rgba(136,192,208,0.02));border:1px solid rgba(136,192,208,0.25);border-radius:14px;padding:18px 10px;text-align:center;transition:all 0.25s ease;\" onmouseover='this.style.transform=\"translateY(-3px)\";this.style.borderColor=\"#88C0D0\";this.style.boxShadow=\"0 8px 24px rgba(136,192,208,0.28)\";' onmouseout='this.style.transform=\"none\";this.style.borderColor=\"rgba(136,192,208,0.25)\";this.style.boxShadow=\"none\";'>\n<div style=\"width:40px;height:40px;margin:0 auto 8px;border-radius:10px;background:rgba(136,192,208,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#88C0D0\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/><line x1=\"11\" y1=\"8\" x2=\"11\" y2=\"14\"/><line x1=\"8\" y1=\"11\" x2=\"14\" y2=\"11\"/></svg></div>\n<div style=\"font-size:11px;font-weight:600;color:#E5E9F0;letter-spacing:0.3px;\">Explore</div>\n</a>\n\n<a href=\"/d/l1-application-performance\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(163,190,140,0.14),rgba(163,190,140,0.02));border:1px solid rgba(163,190,140,0.25);border-radius:14px;padding:18px 10px;text-align:center;transition:all 0.25s ease;\" onmouseover='this.style.transform=\"translateY(-3px)\";this.style.borderColor=\"#A3BE8C\";this.style.boxShadow=\"0 8px 24px rgba(163,190,140,0.28)\";' onmouseout='this.style.transform=\"none\";this.style.borderColor=\"rgba(163,190,140,0.25)\";this.style.boxShadow=\"none\";'>\n<div style=\"width:40px;height:40px;margin:0 auto 8px;border-radius:10px;background:rgba(163,190,140,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#A3BE8C\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg></div>\n<div style=\"font-size:11px;font-weight:600;color:#E5E9F0;letter-spacing:0.3px;\">Drilldown</div>\n</a>\n\n<a href=\"/alerting/list\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(235,203,139,0.14),rgba(235,203,139,0.02));border:1px solid rgba(235,203,139,0.25);border-radius:14px;padding:18px 10px;text-align:center;transition:all 0.25s ease;\" onmouseover='this.style.transform=\"translateY(-3px)\";this.style.borderColor=\"#EBCB8B\";this.style.boxShadow=\"0 8px 24px rgba(235,203,139,0.28)\";' onmouseout='this.style.transform=\"none\";this.style.borderColor=\"rgba(235,203,139,0.25)\";this.style.boxShadow=\"none\";'>\n<div style=\"width:40px;height:40px;margin:0 auto 8px;border-radius:10px;background:rgba(235,203,139,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#EBCB8B\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg></div>\n<div style=\"font-size:11px;font-weight:600;color:#E5E9F0;letter-spacing:0.3px;\">Alerts</div>\n</a>\n\n<a href=\"/connections/datasources\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(180,142,173,0.14),rgba(180,142,173,0.02));border:1px solid rgba(180,142,173,0.25);border-radius:14px;padding:18px 10px;text-align:center;transition:all 0.25s ease;\" onmouseover='this.style.transform=\"translateY(-3px)\";this.style.borderColor=\"#B48EAD\";this.style.boxShadow=\"0 8px 24px rgba(180,142,173,0.28)\";' onmouseout='this.style.transform=\"none\";this.style.borderColor=\"rgba(180,142,173,0.25)\";this.style.boxShadow=\"none\";'>\n<div style=\"width:40px;height:40px;margin:0 auto 8px;border-radius:10px;background:rgba(180,142,173,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#B48EAD\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M21 12c0 1.66-4 3-9 3s-9-1.34-9-3\"/><path d=\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\"/></svg></div>\n<div style=\"font-size:11px;font-weight:600;color:#E5E9F0;letter-spacing:0.3px;\">Data Sources</div>\n</a>\n\n<a href=\"/admin\" class=\"gh_tile\" style=\"text-decoration:none;background:linear-gradient(145deg,rgba(94,129,172,0.14),rgba(94,129,172,0.02));border:1px solid rgba(94,129,172,0.25);border-radius:14px;padding:18px 10px;text-align:center;transition:all 0.25s ease;\" onmouseover='this.style.transform=\"translateY(-3px)\";this.style.borderColor=\"#5E81AC\";this.style.boxShadow=\"0 8px 24px rgba(94,129,172,0.28)\";' onmouseout='this.style.transform=\"none\";this.style.borderColor=\"rgba(94,129,172,0.25)\";this.style.boxShadow=\"none\";'>\n<div style=\"width:40px;height:40px;margin:0 auto 8px;border-radius:10px;background:rgba(94,129,172,0.15);display:flex;align-items:center;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5E81AC\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></div>\n<div style=\"font-size:11px;font-weight:600;color:#E5E9F0;letter-spacing:0.3px;\">Admin</div>\n</a>\n\n</div>\n\n<div style=\"margin-top:34px;display:flex;align-items:center;gap:24px;font-size:11px;color:#4C566A;letter-spacing:0.4px;flex-wrap:wrap;justify-content:center;\">\n<span style=\"display:flex;align-items:center;gap:6p