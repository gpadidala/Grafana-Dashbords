          },
          "pluginVersion": "11.6.4",
          "targets": [
            {
              "datasource": { "type": "mssql", "uid": "$datasource" },
              "rawSql": "SELECT TOP $top_n\n  DB_NAME(qt.dbid) AS database_name,\n  CAST(qs.total_worker_time / 1000000.0 AS DECIMAL(18,2)) AS total_worker_time_sec,\n  qs.execution_count,\n  CAST(qs.total_worker_time * 1.0 / NULLIF(qs.execution_count,0) / 1000.0 AS DECIMAL(18,2)) AS avg_worker_time_ms,\n  CAST(qs.total_elapsed_time * 1.0 / NULLIF(qs.execution_count,0) / 1000.0 AS DECIMAL(18,2)) AS avg_elapsed_ms,\n  qs.total_logical_reads / NULLIF(qs.execution_count,0) AS avg_logical_reads,\n  qs.total_physical_reads / NULLIF(qs.execution_count,0) AS avg_physical_reads,\n  qs.last_execution_time,\n  SUBSTRING(qt.text,\n    (qs.statement_start_offset/2)+1,\n    ((CASE qs.statement_end_offset\n        WHEN -1 THEN DATALENGTH(qt.text)\n        ELSE qs.statement_end_offset END - qs.statement_start_offset)/2)+1) AS query_text\nFROM sys.dm_exec_query_stats qs\nCROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) qt\nWHERE qt.dbid IS NULL OR qt.dbid > 4\nORDER BY qs.total_worker_time DESC;",
              "format": "table",
              "refId": "A"
            }
          ],
          "title": "Top Expensive Queries (CPU)",
