{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Microsoft SQL Server performance deep-dive: server health, sessions, waits, buffer pool, memory, transactions, I/O, top expensive queries, and database sizes. Datasource-agnostic — works with any MSSQL datasource configured in Grafana.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "links": [
    { "title": "⬆ Platform KPI", "url": "/d/ultimate-platform-kpi", "type": "link", "icon": "dashboard", "targetBlank": false, "tooltip": "Single Pane of Glass", "asDropdown": false, "includeVars": true, "keepTime": true },
    { "title": "Grafana DB Deep Dive", "url": "/d/grafana-db-perf-deep-dive", "type": "link", "icon": "dashboard", "targetBlank": false, "asDropdown": false, "includeVars": true, "keepTime": true },
    { "title": "MSSQL Advanced Diagnostics", "url": "/d/mssql-advanced-diagnostics", "type": "link", "icon": "dashboard", "targetBlank": false, "asDropdown": false, "includeVars": true, "keepTime": true }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Health Signals",
      "type": "row"
    },
    {
      "datasource": { "type": "mssql", "uid": "$datasource" },
      "description": "SQL Server uptime since service start.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.4",
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "rawSql": "SELECT DATEDIFF(SECOND, sqlserver_start_time, GETUTCDATE()) AS uptime_seconds FROM sys.dm_os_sys_info;",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "$datasource" },
      "description": "Current SQL Server CPU utilization (last sample from sys.dm_os_ring_buffers).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 70 }, { "color": "#F2495C", "value": 90 } ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.4",
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "rawSql": "SELECT TOP 1 r.SQLProcessUtilization AS cpu_pct\nFROM (\n  SELECT record.value('(./Record/SchedulerMonitorEvent/SystemHealth/SystemIdle)[1]','int') AS SystemIdle,\n         record.value('(./Record/SchedulerMonitorEvent/SystemHealth/ProcessUtilization)[1]','int') AS SQLProcessUtilization,\n         TIMESTAMP\n  FROM ( SELECT TIMESTAMP, CONVERT(xml, record) AS record\n         FROM sys.dm_os_ring_buffers\n         WHERE ring_buffer_type = N'RING_BUFFER_SCHEDULER_MONITOR'\n           AND record LIKE N'%<SystemHealth>%' ) AS x\n) AS r\nORDER BY r.TIMESTAMP DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "CPU %",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "$datasource" },
      "description": "User sessions currently connected.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 500 }, { "color": "#F2495C", "value": 1000 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.4",
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "rawSql": "SELECT COUNT(*) AS sessions FROM sys.dm_exec_sessions WHERE is_user_process = 1;",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Active Sessions",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "$datasource" },
      "description": "Sessions blocked by another session. Non-zero = active blocking.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 1 }, { "color": "#F2495C", "value": 10 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.4",
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "rawSql": "SELECT COUNT(*) AS blocked FROM sys.dm_exec_requests WHERE blocking_session_id <> 0;",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Blocked Sessions",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "$datasource" },
      "description": "Page Life Expectancy (sec). <300s on a busy OLTP server signals memory pressure.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#F2495C", "value": null }, { "color": "#FF9830", "value": 300 }, { "color": "#73BF69", "value": 1000 } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.4",
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "rawSql": "SELECT AVG(CAST(cntr_value AS BIGINT)) AS ple FROM sys.dm_os_performance_counters WHERE counter_name = 'Page life expectancy' AND object_name LIKE '%Buffer Manager%';",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Page Life Expectancy",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "$datasource" },
      "description": "Buffer cache hit ratio. >95% is healthy on most workloads.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#F2495C", "value": null }, { "color": "#FF9830", "value": 90 }, { "color": "#73BF69", "value": 95 } ] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.4",
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "rawSql": "SELECT (CAST(a.cntr_value AS FLOAT) / NULLIF(b.cntr_value, 0)) * 100 AS hit_ratio\nFROM sys.dm_os_performance_counters a\nJOIN sys.dm_os_performance_counters b\n  ON a.object_name = b.object_name\nWHERE a.counter_name = 'Buffer cache hit ratio'\n  AND b.counter_name = 'Buffer cache hit ratio base'\n  AND a.object_name LIKE '%Buffer Manager%';",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Buffer Cache Hit Ratio",
      "type": "stat"
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "description": "Historical CPU utilization from sys.dm_os_ring_buffers (last ~256 minutes).",
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": {
                "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
                "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "scheme",
                "hideFrom": { "legend": false, "tooltip": false, "viz": false },
                "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
                "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false,
                "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
              },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
              "unit": "percent"
            },
            "overrides": [
              { "matcher": { "id": "byName", "options": "SQL Server" }, "properties": [ { "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } } ] },
              { "matcher": { "id": "byName", "options": "Other" }, "properties": [ { "id": "color", "value": { "fixedColor": "#6ED0E0", "mode": "fixed" } } ] },
              { "matcher": { "id": "byName", "options": "Idle" }, "properties": [ { "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } } ] }
            ]
          },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
          "id": 7,
          "options": {
            "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "sortBy": "Max", "sortDesc": true },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "pluginVersion": "11.6.4",
          "targets": [
            {
              "datasource": { "type": "mssql", "uid": "$datasource" },
              "rawSql": "DECLARE @ts_now BIGINT;\nSELECT @ts_now = ms_ticks FROM sys.dm_os_sys_info;\nSELECT\n  DATEADD(ms, -1 * (@ts_now - [timestamp]), GETUTCDATE()) AS time,\n  SQLProcessUtilization AS [SQL Server],\n  100 - SystemIdle - SQLProcessUtilization AS [Other],\n  SystemIdle AS [Idle]\nFROM (\n  SELECT record.value('(./Record/SchedulerMonitorEvent/SystemHealth/SystemIdle)[1]','int') AS SystemIdle,\n         record.value('(./Record/SchedulerMonitorEvent/SystemHealth/ProcessUtilization)[1]','int') AS SQLProcessUtilization,\n         TIMESTAMP AS [timestamp]\n  FROM ( SELECT TIMESTAMP, CONVERT(xml, record) AS record\n         FROM sys.dm_os_ring_buffers\n         WHERE ring_buffer_type = N'RING_BUFFER_SCHEDULER_MONITOR'\n           AND record LIKE N'%<SystemHealth>%' ) AS x\n) AS y\nORDER BY time;",
              "format": "time_series",
              "refId": "A"
            }
          ],
          "title": "CPU Utilization Over Time",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "description": "Memory committed by SQL Server vs target. Plateau below target may indicate memory limit.",
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": {
                "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
                "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "scheme",
                "hideFrom": { "legend": false, "tooltip": false, "viz": false },
                "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
                "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false,
                "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
              },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
              "unit": "decmbytes"
            },
            "overrides": [
              { "matcher": { "id": "byName", "options": "Target Memory MB" }, "properties": [ { "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 } ] },
              { "matcher": { "id": "byName", "options": "Total Server Memory MB" }, "properties": [ { "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } } ] }
            ]
          },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
          "id": 8,
          "options": {
            "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "sortBy": "Max", "sortDesc": true },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "pluginVersion": "11.6.4",
          "targets": [
            {
              "datasource": { "type": "mssql", "uid": "$datasource" },
              "rawSql": "SELECT\n  GETUTCDATE() AS time,\n  CAST(cntr_value AS BIGINT) / 1024.0 AS [Total Server Memory MB]\nFROM sys.dm_os_performance_counters\nWHERE counter_name = 'Total Server Memory (KB)';",
              "format": "time_series",
              "refId": "A"
            },
            {
              "datasource": { "type": "mssql", "uid": "$datasource" },
              "rawSql": "SELECT\n  GETUTCDATE() AS time,\n  CAST(cntr_value AS BIGINT) / 1024.0 AS [Target Memory MB]\nFROM sys.dm_os_performance_counters\nWHERE counter_name = 'Target Server Memory (KB)';",
              "format": "time_series",
              "refId": "B"
            }
          ],
          "title": "Memory: Total vs Target",
          "type": "timeseries"
        }
      ],
      "title": "Server Resource Trends",
      "type": "row"
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "panels": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "description": "Active sessions broken out by status.",
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": {
                "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
                "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "scheme",
                "hideFrom": { "legend": false, "tooltip": false, "viz": false },
                "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5,
                "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false,
                "stacking": { "group": "A", "mode": "normal" }, "thresholdsStyle": { "mode": "off" }
              },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
          "id": 9,
          "options": {
            "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "pluginVersion": "11.6.4",
          "targets": [
            {
              "datasource": { "type": "mssql", "uid": "$datasource" },
              "rawSql": "SELECT\n  GETUTCDATE() AS time,\n  status,\n  COUNT(*) AS sessions\nFROM sys.dm_exec_sessions\nWHERE is_user_process = 1\nGROUP BY status;",
              "format": "time_series",
              "refId": "A"
            }
          ],
          "title": "Sessions by Status",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "description": "Top login names by active session count.",
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
            },
            "overrides": [
              { "matcher": { "id": "byName", "options": "sessions" }, "properties": [ { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } }, { "id": "custom.width", "value": 220 } ] }
            ]
          },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
          "id": 10,
          "options": {
            "cellHeight": "sm",
            "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
            "showHeader": true,
            "sortBy": [{ "desc": true, "displayName": "sessions" }]
          },
          "pluginVersion": "11.6.4",
          "targets": [
            {
              "datasource": { "type": "mssql", "uid": "$datasource" },
              "rawSql": "SELECT TOP 25\n  ISNULL(login_name, '(none)') AS login_name,\n  ISNULL(host_name, '(none)') AS host_name,\n  ISNULL(program_name, '(none)') AS program_name,\n  COUNT(*) AS sessions\nFROM sys.dm_exec_sessions\nWHERE is_user_process = 1\nGROUP BY login_name, host_name, program_name\nORDER BY sessions DESC;",
              "format": "table",
              "refId": "A"
            }
          ],
          "title": "Top Logins / Hosts / Programs",
          "type": "table"
        }
      ],
      "title": "Sessions & Connections",
      "type": "row"
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "panels": [
        {
          "datasource": { "type": "mssql", "uid": "$datasource" },
          "description": "Top wait types since last server restart (excluding benign waits).",
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
              "mappings": [],
              "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
            },
            "overrides": [
              { "matcher": { "id": "byName", "options": "wait_time_sec" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } }, { "id": "custom.width", "value": 220 } ] },
              { "matcher": { "id": "byName", "options": "pct_of_total" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] },
              { "matcher": { "id": "byName", "options": "avg_wait_ms" }, "properties": [ { "id": "unit", "value": "ms" } ] }
            ]
          },
          "gridPos": { "h": 10, "w": 12, "x": 0, "y": 24 },
          "id": 11,
          "options": {
            "cellHeight": "sm",
            "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
            "showHeader": true,
            "sortBy": [{ "desc": true, "displayName": "wait_time_sec" }]
          },
          "pluginVersion": "11.6.4",
          "targets": [
            {
              "datasource": { "type": "mssql", "uid": "$datasource" },
              "rawSql": "WITH waits AS (\n  SELECT wait_type,\n         wait_time_ms,\n         waiting_tasks_count,\n         signal_wait_time_ms\n  FROM sys.dm_os_wait_stats\n  WHERE wait_type NOT IN (\n    'BROKER_EVENTHANDLER','BROKER_RECEIVE_WAITFOR','BROKER_TASK_STOP','BROKER_TO_FLUSH','BROKER_TRANSMITTER',\n    'CHECKPOINT_QUEUE','CHKPT','CLR_AUTO_EVENT','CLR_MANUAL_EVENT','CLR_SEMAPHORE','DBMIRROR_EVENTS_QUEUE',\n    'DBMIRRORING_CMD','DIRTY_PAGE_POLL','DISPATCHER_QUEUE_SEMAPHORE','EXECSYNC','FSAGENT','FT_IFTS_SCHEDULER_IDLE_WAIT',\n    'FT_IFTSHC_MUTEX','HADR_CLUSAPI_CALL','HADR_FILESTREAM_IOMGR_IOCOMPLETION','HADR_LOGCAPTURE_WAIT','HADR_NOTIFICATION_DEQUEUE',\n    'HADR_TIMER_TASK','HADR_WORK_QUEUE','KSOURCE_WAKEUP','LAZYWRITER_SLEEP','LOGMGR_QUEUE','MEMORY_ALLOCATION_EXT',\n    'ONDEMAND_TASK_QUEUE','PARALLEL_REDO_DRAIN_WORKER','PARALLEL_REDO_LOG_CAPTURE','PARALLEL_REDO_TRAN_LIST','PREEMPTIVE_HADR_LEASE_MECHANISM',\n    'PREEMPTIVE_OS_AUTHENTICATIONOPS','PREEMPTIVE_XE_GETTARGETSTATE','PWAIT_ALL_COMPONENTS_INITIALIZED','PWAIT_DIRECTLOGCONSUMER_GETNEXT',\n    'QDS_PERSIST_TASK_MAIN_LOOP_SLEEP','QDS_ASYNC_QUEUE','QDS_CLEANUP_STALE_QUERIES_TASK_MAIN_LOOP_SLEEP','QDS_SHUTDOWN_QUEUE',\n    'REDO_THREAD_PENDING_WORK','REQUEST_FOR_DEADLOCK_SEARCH','RESOURCE_QUEUE','SERVER_IDLE_CHECK','SLEEP_BPOOL_FLUSH',\n    'SLEEP_DBSTARTUP','SLEEP_DCOMSTARTUP','SLEEP_MASTERDBREADY','SLEEP_MASTERMDREADY','SLEEP_MASTERUPGRADED','SLEEP_MSDBSTARTUP',\n    'SLEEP_SYSTEMTASK','SLEEP_TASK','SLEEP_TEMPDBSTARTUP','SNI_HTTP_ACCEPT','SP_SERVER_DIAGNOSTICS_SLEEP','SQLTRACE_BUFFER_FLUSH',\n    'SQLTRACE_INCREMENTAL_FLUSH_SLEEP','SQLTRACE_WAIT_ENTRIES','WAIT_FOR_RESULTS','WAITFOR','WAITFOR_TASKSHUTDOWN',\n    'WAIT_XTP_RECOVERY','WAIT_XTP_HOST_WAIT','WAIT_XTP_OFFLINE_CKPT_NEW_LOG','WAIT_XTP_CKPT_CLOSE','XE_DISPATCHER_JOIN',\n    'XE_DISPATCHER_WAIT','XE_TIMER_EVENT'\n  )\n  AND waiting_tasks_count > 0\n)\nSELECT TOP 25\n  wait_type,\n  CAST(wait_time_ms / 1000.0 AS DECIMAL(18,2)) AS wait_time_sec,\n  waiting_tasks_count,\n  CAST(wait_time_ms * 1.0 / NULLIF(waiting_tasks_count,0) AS DECIMAL(18,2)) AS avg_wait_ms,\n  CAST(100.0 * wait_time_ms / NULLIF(SUM(wait_time_ms) OVER (), 0) AS DECIMAL(5,2)) AS pct_of_total\nFROM waits\nORDER BY wait_time_ms DESC;",
              "format": "table",
              "refId": "A"
