              { "matcher": { "id": "byName", "options": "avg_worker_time_ms" }, "properties": [ { "id": "unit", "value": "ms" } ] },
              { "matcher": { "id": "byName", "options": "avg_logical_reads" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] },
              { "matcher": { "id": "byName", "options": "query_text" }, "properties": [ { "id": "custom.width", "value": 600 } ] }
