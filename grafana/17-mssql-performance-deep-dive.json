              "rawSql": "SELECT\n  DB_NAME(vfs.database_id) AS database_name,\n  mf.physical_name,\n  mf.type_desc,\n  CAST(num_of_bytes_read / 1024.0 / 1024.0 / 1024.0 AS DECIMAL(18,2)) AS read_gb,\n  CAST(num_of_bytes_written / 1024.0 / 1024.0 / 1024.0 AS DECIMAL(18,2)) AS write_gb,\n  CAST(io_stall_read_ms * 1.0 / NULLIF(num_of_reads, 0) AS DECIMAL(18,2)) AS avg_read_ms,\n  CAST(io_stall_write_ms * 1.0 / NULLIF(num_of_writes, 0) AS DECIMAL(18,2)) AS avg_write_ms,\n  num_of_reads,\n  num_of_writes\nFROM sys.dm_io_virtual_file_stats(NULL, NULL) vfs\nJOIN sys.master_files mf\n  ON vfs.database_id = mf.database_id AND vfs.file_id = mf.file_id\nORDER BY (io_stall_read_ms + io_stall_write_ms) DESC;",
