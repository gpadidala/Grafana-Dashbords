    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "HTTP p95 latency ratio: current / baseline (before Faro). ≤1.05 = pass.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 1.05 }, { "color": "#F2495C", "value": 1.15 } ] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m]))) / histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m] offset $baseline_offset)))", "legendFormat": "ratio", "refId": "A" } ],
      "title": "HTTP p95 Ratio vs Baseline",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "CPU ratio: current / baseline. ≤1.05 pass.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 1.05 }, { "color": "#F2495C", "value": 1.15 } ] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "avg(rate(process_cpu_seconds_total{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m])) / avg(rate(process_cpu_seconds_total{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m] offset $baseline_offset))", "legendFormat": "cpu ratio", "refId": "A" } ],
      "title": "CPU Ratio vs Baseline",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Memory ratio: current / baseline.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 1.05 }, { "color": "#F2495C", "value": 1.15 } ] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "avg(process_resident_memory_bytes{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}) / avg(process_resident_memory_bytes{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"} offset $baseline_offset)", "legendFormat": "mem ratio", "refId": "A" } ],
      "title": "Memory Ratio vs Baseline",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Error-rate ratio: current / baseline. ≤1.0 = no new 5xx.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 1.05 }, { "color": "#F2495C", "value": 1.2 } ] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "(sum(rate(grafana_http_request_duration_seconds_count{status_code=~\"5..\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m])) / sum(rate(grafana_http_request_duration_seconds_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m]))) / (sum(rate(grafana_http_request_duration_seconds_count{status_code=~\"5..\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m] offset $baseline_offset)) / sum(rate(grafana_http_request_duration_seconds_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[15m] offset $baseline_offset)))", "legendFormat": "err ratio", "refId": "A" } ],
      "title": "5xx Rate Ratio vs Baseline",
      "type": "stat"
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "id": 101, "title": "📉 HTTP Latency — Before/After Faro", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Grafana HTTP p50/p95/p99 overlaid with baseline (dashed).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": true }, "unit": "s" }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*baseline" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 } ] } ] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p50 current", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p95 current", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval])))", "legendFormat": "p99 current", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval] offset $baseline_offset)))", "legendFormat": "p50 baseline", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval] offset $baseline_offset)))", "legendFormat": "p95 baseline", "refId": "E" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval] offset $baseline_offset)))", "legendFormat": "p99 baseline", "refId": "F" }
      ],
      "title": "Grafana HTTP Latency (current vs baseline)",
      "type": "timeseries"
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "id": 102, "title": "🖥️ Resource Usage", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "CPU seconds rate — current (solid) vs baseline (dashed).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "unit": "percentunit" }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*baseline" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [10, 10] } } ] } ] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "rate(process_cpu_seconds_total{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval])", "legendFormat": "{{instance}} current", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "rate(process_cpu_seconds_total{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval] offset $baseline_offset)", "legendFormat": "{{instance}} baseline", "refId": "B" }
      ],
      "title": "CPU — Current vs Baseline",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "RSS memory — current vs baseline.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "unit": "bytes" }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*baseline" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [10, 10] } } ] } ] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "process_resident_memory_bytes{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}", "legendFormat": "{{instance}} current", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "process_resident_memory_bytes{job=\"grafana\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"} offset $baseline_offset", "legendFormat": "{{instance}} baseline", "refId": "B" }
      ],
      "title": "Memory — Current vs Baseline",
      "type": "timeseries"
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "id": 103, "title": "🗄️ Database Impact", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "DB connection pool saturation (current vs baseline).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "unit": "percent" }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*baseline" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [10, 10] } } ] } ] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
