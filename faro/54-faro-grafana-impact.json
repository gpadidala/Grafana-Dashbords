        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "grafana_database_conn_in_use{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"} offset $baseline_offset / grafana_database_conn_max_open{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"} offset $baseline_offset * 100", "legendFormat": "{{instance}} baseline", "refId": "B" }
      ],
      "title": "DB Pool Saturation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
