    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "LCP p75 by browser — identify slow browsers.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "auto", "cellOptions": { "type": "color-background" }, "filterable": true }, "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FF9830", "value": 2.5 }, { "color": "#F2495C", "value": 4 } ] }, "unit": "s" } },
