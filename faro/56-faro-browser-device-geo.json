      ],
      "title": "CWV & Errors by Browser",
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": { "browser_name": 0 }, "renameByName": { "Value #A": "LCP p75", "Value #B": "INP p75", "Value #C": "Error Rate" } } }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "LCP p75 by geo country.",
