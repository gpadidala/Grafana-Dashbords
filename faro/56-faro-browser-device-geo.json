        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "histogram_quantile(0.75, sum by (le, country) (rate(faro_web_vitals_ttfb_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__range])))", "format": "table", "instant": true, "refId": "B" }
      ],
      "title": "CWV by Country",
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "indexByName": { "country": 0 }, "renameByName": { "Value #A": "LCP p75", "Value #B": "TTFB p75" } } }
      ],
      "type": "table"
    },
