      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "sum by (viewport_bucket) (rate(faro_page_views_total{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{viewport_bucket}}", "refId": "A" } ],
      "title": "Viewport Distribution",
