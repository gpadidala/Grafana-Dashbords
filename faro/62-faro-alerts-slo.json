    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "id": 101, "title": "🚨 Active Alerts & Rule Health", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Currently-firing Grafana alert rules tagged with faro.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }, "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#F2495C", "value": 1 } ] } }, "overrides": [ { "matcher": { "id": "byName", "options": "alertstate" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [ { "type": "value", "options": { "firing": { "color": "#F2495C", "text": "🚨 FIRING" } } }, { "type": "value", "options": { "pending": { "color": "#FF9830", "text": "⏳ PENDING" } } }, { "type": "value", "options": { "normal": { "color": "#73BF69", "text": "✅ OK" } } } ] } ] } ] },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [ { "desc": true, "displayName": "alertstate" } ] },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "ALERTS{alertname=~\".*faro.*|.*FRONTEND.*|.*RUM.*|.*WEBVITALS.*\",cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}", "format": "table", "instant": true, "refId": "A" } ],
      "title": "Faro-Related Alerts",
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "Value": true } } } ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Alert rule evaluation p95 & failures — rule-engine health.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "unit": "s" } },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 18 },
