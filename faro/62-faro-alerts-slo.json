        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "sum(rate(grafana_alerting_rule_evaluation_failures_total{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "failures /s", "refId": "B" }
