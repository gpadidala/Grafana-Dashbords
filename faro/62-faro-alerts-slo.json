        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "sum by (type) (rate(grafana_alerting_notifications_failed_total{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "failed {{type}}", "refId": "B" }
      ],
