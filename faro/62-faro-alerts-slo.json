      "targets": [
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "((sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[5m])) - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\",le=\"2.5\"}[5m]))) / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[5m]))) / 0.05", "legendFormat": "5m", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "((sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[1h])) - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\",le=\"2.5\"}[1h]))) / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[1h]))) / 0.05", "legendFormat": "1h", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "((sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[6h])) - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\",le=\"2.5\"}[6h]))) / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[6h]))) / 0.05", "legendFormat": "6h", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "((sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[1d])) - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\",le=\"2.5\"}[1d]))) / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[1d]))) / 0.05", "legendFormat": "1d", "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "((sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[3d])) - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\",le=\"2.5\"}[3d]))) / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[3d]))) / 0.05", "legendFormat": "3d", "refId": "E" }
      ],
      "title": "Burn-Rate — MWMBR Window Family",
