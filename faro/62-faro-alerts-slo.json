      "type": "timeseries"
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 }, "id": 103, "title": "📝 Recommended Alert Rules (copy these)", "type": "row" },
    {
      "datasource": { "type": "grafana", "uid": "-- Grafana --" },
      "description": "Recommended PromQL alert rules to protect the Faro SLOs. Click panel → Inspect → Panel JSON to copy.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 38 },
      "id": 9,
      "options": { "code": { "language": "yaml", "showLineNumbers": true, "showMiniMap": false }, "content": "# Faro Recommended Alert Rules (Prometheus / Grafana Managed)\n# Multi-Window Multi-Burn-Rate (MWMBR) for SLO: 95% of pageloads have LCP <= 2.5s\n\n- alert: FaroLCPSLOFastBurn\n  expr: |\n    (\n      (sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\"}[5m]))\n       - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",le=\"2.5\"}[5m])))\n      / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\"}[5m]))\n    ) / 0.05 > 14.4\n    AND\n    (\n      (sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\"}[1h]))\n       - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",le=\"2.5\"}[1h])))\n      / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\"}[1h]))\n    ) / 0.05 > 14.4\n  for: 2m\n  labels: { severity: page, team: frontend }\n  annotations: { summary: \"Faro LCP SLO burning fast — 2% of 30d budget in 1h\" }\n\n- alert: FaroLCPSLOSlowBurn\n  expr: |\n    (...1h burn > 6 AND 6h burn > 6...)\n  for: 15m\n  labels: { severity: ticket, team: frontend }\n\n- alert: FaroErrorRateHigh\n  expr: |\n    (sum(rate(faro_exceptions_total{cluster=~\"$cluster\"}[5m]))\n     / sum(rate(faro_page_views_total{cluster=~\"$cluster\"}[5m]))) * 1000 > 20\n  for: 5m\n  labels: { severity: page, team: frontend }\n  annotations: { summary: \"Frontend error rate > 20 per 1k pageviews\" }\n\n- alert: FaroCollectorDown\n  expr: sum(rate(faro_receiver_requests_total{cluster=~\"$cluster\"}[5m])) == 0\n  for: 3m\n  labels: { severity: page, team: platform }\n  annotations: { summary: \"Faro collector receiving no beacons — ingestion broken\" }\n\n- alert: FaroBeaconExportFailures\n  expr: sum(rate(faro_exporter_send_failed_total{cluster=~\"$cluster\"}[5m])) > 1\n  for: 5m\n  labels: { severity: ticket, team: platform }\n\n- alert: FaroSDKTransportFailures\n  expr: sum(rate(faro_sdk_transport_failures_total{cluster=~\"$cluster\"}[5m])) > 5\n  for: 10m\n  labels: { severity: ticket, team: frontend }\n  annotations: { summary: \"Browser SDK unable to deliver beacons (CSP/CORS/network)\" }\n\n- alert: FaroGrafanaBackendRegression\n  expr: |\n    histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\"}[15m])))\n    /\n    histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{cluster=~\"$cluster\"}[15m] offset 1d)))\n    > 1.15\n  for: 10m\n  labels: { severity: page, team: platform }\n  annotations: { summary: \"Grafana backend p95 >15% slower than 1d baseline — suspect Faro regression\" }", "mode": "markdown" },
      "pluginVersion": "11.6.4",
      "title": "Alert Rule Templates (PromQL)",
      "type": "text"
    }
  ],
  "refresh": "1m",
