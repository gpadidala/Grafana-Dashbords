      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "((sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[6h])) - sum(rate(faro_web_vitals_lcp_bucket{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\",le=\"2.5\"}[6h]))) / sum(rate(faro_web_vitals_lcp_count{cluster=~\"$cluster\",stack=~\"$stack\",namespace=~\"$namespace\"}[6h]))) / 0.05", "refId": "A" } ],
