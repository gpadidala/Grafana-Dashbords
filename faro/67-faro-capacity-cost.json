      "targets": [ { "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "sum(count by (__name__)({__name__=~\"faro_.*\",cluster=~\"$cluster\",stack=~\"$stack\"})) * $price_per_series", "refId": "A" } ],
      "title": "Mimir $/day",
      "type": "stat"
